{
  "name": "@yhnocoder/vizflow",
  "version": "0.1.0",
  "type": "module",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css",
    "./src/theme/index.ts",
    "./src/autograd/ops/index.ts",
    "./src/theme/fonts.ts",
    "./src/theme/fonts.module.ts",
    "./src/ui/index.ts",
    "./src/formula/katex-style.ts",
    "./src/formula/katex-style.module.ts",
    "./src/scene3d/index.ts",
    "./src/scene3d/edit.ts",
    "./src/element/index.ts",
    "./dist/*.js",
    "./dist/module/*.js"
  ],
  "exports": {
    "./core": {
      "types": "./dist/types/core.d.ts",
      "import": "./dist/module/core.js"
    },
    "./explain": {
      "types": "./dist/types/explain/index.d.ts",
      "import": "./dist/module/explain.js"
    },
    "./steps": {
      "types": "./dist/types/steps/index.d.ts",
      "import": "./dist/module/steps.js"
    },
    "./ui": {
      "types": "./dist/types/ui/index.d.ts",
      "import": "./dist/module/ui.js"
    },
    "./scene3d": {
      "types": "./dist/types/scene3d/index.d.ts",
      "import": "./dist/module/scene3d.js"
    },
    "./formula": {
      "types": "./dist/types/formula/index.d.ts",
      "import": "./dist/module/formula.js"
    },
    "./theme": {
      "types": "./dist/types/theme/index.d.ts",
      "import": "./dist/module/theme.js"
    },
    "./element": {
      "types": "./dist/types/element/index.d.ts",
      "import": "./dist/module/element.js"
    },
    "./dsl": {
      "types": "./dist/types/dsl/index.d.ts",
      "import": "./dist/module/dsl.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --mode module",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "typecheck:fast": "tsgo --noEmit",
    "test:fast": "vitest run --changed --passWithNoTests",
    "check:fast": "sh scripts/check_fast.sh"
  },
  "dependencies": {
    "@fontsource/geist": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.0",
    "katex": "^0.19.0",
    "solid-js": "^1.9.17",
    "three": "^0.186.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "^22.20.5",
    "@types/three": "^0.186.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "jsdom": "^30.1.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vite-plugin-dts": "^5.1.2",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^5.0.3"
  }
}
